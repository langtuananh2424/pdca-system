# Sao chép thành deploy/.env (đã gitignore) và đặt mật khẩu riêng.
# Không commit deploy/.env.
POSTGRES_PASSWORD=
FLYWAY_PASSWORD=
PDCA_APP_PASSWORD=
PDCA_READONLY_PASSWORD=

PDCA_ENV=dev
# Bỏ seed dev ở staging/prod: FLYWAY_LOCATIONS=filesystem:/flyway/sql
# FLYWAY_LOCATIONS=
TZ_DEFAULT=Asia/Bangkok
DB_PORT=5432
# MCP Server mở trên 127.0.0.1:<cổng> cho reverse proxy của máy chủ (nginx).
MCP_HTTP_PORT=8010
# Cổng Caddy (chỉ dùng với --profile caddy).
HTTP_PORT=80
HTTPS_PORT=443
# Tên miền công khai của MCP Server (máy chủ: tên miền thật hoặc <ip>.sslip.io).
PDCA_DOMAIN=localhost

# MCP Server (LLD 8.1)
RATE_LIMIT_PER_MIN=60
OUTPUT_MAX_ROWS=100
OUTPUT_MAX_BYTES=51200

# Agent Service (LLD 8.1) — để trống khi chưa dùng.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL_SMALL=
LLM_MODEL_MEDIUM=
LLM_MODEL_LARGE=
LLM_MONTHLY_BUDGET_USD=
CHANNEL_KIND=log
# Email (CHANNEL_KIND=email). Dev với Mailpit (--profile mail):
#   SMTP_HOST=mailpit SMTP_PORT=1025 SMTP_SECURITY=none
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=
NTF_MAX_PER_DAY=3
OUTBOX_MAX_ATTEMPTS=5

# Hỏi cấp trên (FR-ASK): hạn trả lời (ngày), số câu hỏi mở tối đa, số câu hỏi mỗi ngày.
QUESTION_TTL_DAYS=3
QUESTION_MAX_OPEN=5
QUESTION_MAX_PER_DAY=10

# Lịch job (crontab, theo TZ_DEFAULT) — để trống dùng mặc định LLD 5.2
# JOB_MORNING_NUDGE_CRON=30 8 * * mon-fri
# JOB_PROGRESS_ASK_CRON=45 16 * * mon-fri
# JOB_PROGRESS_REMIND_CRON=15 17 * * mon-fri
# JOB_MARK_NOT_REPORTED_CRON=30 18 * * mon-fri
CHANNEL_CREDENTIALS=
RULES_REPO_URL=
RULES_REF=
